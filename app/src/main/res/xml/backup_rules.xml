<?xml version="1.0" encoding="utf-8"?>
<!--
    The same exclusions as `data_extraction_rules.xml`, for API 30 — which is minSdk, so this file is
    not vestigial: it is the only one an Android 11 phone reads. From API 31 this one is ignored and
    the other takes over, which is why the two must be changed together. The reasoning for each entry
    is written out there rather than duplicated here.

    Note the older format has no device-transfer section: on API 30 these rules govern cloud backup,
    and the transfer path did not exist yet.

    `platforms` — the platform photographs — is deliberately **not** excluded, for reasons written out
    there. It is the one directory of images in `filesDir` that is meant to survive a phone swap.
-->
<full-backup-content>
    <exclude domain="file" path="tls" />
    <exclude domain="file" path="recordings" />
    <exclude domain="file" path="osmdroid" />
    <exclude domain="file" path="tracks" />
</full-backup-content>
